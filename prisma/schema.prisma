generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── EMPRESA (TENANT) ────────────────────────────────────────────────────────
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  phone     String?
  email     String?
  logo      String?
  address   String?
  plan      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  visits        Visit[]
  reports       Report[]
  subscriptions Subscription[]
  quotations    Quotation[]
}

// ─── USUÁRIO ─────────────────────────────────────────────────────────────────
model User {
  id            String               @id @default(cuid())
  name          String
  email         String               @unique
  password      String
  role          Role                 @default(TECHNICIAN)
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  statusHistory VisitStatusHistory[]
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id])

  visits            Visit[]
  reports           Report[]
  quotationsCreated Quotation[] @relation("QuotationsCreated")
}

enum Role {
  ADMIN
  TECHNICIAN
  READER
  SUPERADMIN
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String
  mpSubscriptionId String?            @unique
  planKey          String
  status           SubscriptionStatus @default(PENDING)
  checkoutUrl      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

// ─── CLIENTE ─────────────────────────────────────────────────────────────────
model Client {
  id           String   @id @default(cuid())
  name         String
  fantasyName  String?
  cnpj         String?
  phone        String?
  email        String?
  address      String?
  neighborhood String?
  city         String?
  state        String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  visits     Visit[]
  quotations Quotation[]
}

// ─── VISITA ───────────────────────────────────────────────────────────────────
model Visit {
  id                String               @id @default(cuid())
  scheduledAt       DateTime
  realizedAt        DateTime?
  status            VisitStatus          @default(SCHEDULED)
  notRealizedReason String?
  observations      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  statusHistory     VisitStatusHistory[]
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  report     Report?
  quotations Quotation[]
}

enum VisitStatus {
  SCHEDULED
  REALIZED
  NOT_REALIZED
}

// ─── RELATÓRIO ────────────────────────────────────────────────────────────────
model Report {
  id              String       @id @default(cuid())
  status          ReportStatus @default(DRAFT)
  observations    String?
  checklistData   Json?
  measurementData Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  visitId String @unique
  visit   Visit  @relation(fields: [visitId], references: [id])

  filledById String
  filledBy   User   @relation(fields: [filledById], references: [id])

  attachments Attachment[]
  signature   Signature?
  pdf         ReportPdf?
}

enum ReportStatus {
  DRAFT
  FINALIZED
  SIGNED
}

// ─── ANEXO ────────────────────────────────────────────────────────────────────
model Attachment {
  id           String         @id @default(cuid())
  type         AttachmentType
  originalName String
  sizeBytes    Int
  mimeType     String
  storagePath  String
  createdAt    DateTime       @default(now())

  companyId String
  reportId  String
  report    Report @relation(fields: [reportId], references: [id])
}

enum AttachmentType {
  PHOTO
  PDF
}

// ─── ASSINATURA ───────────────────────────────────────────────────────────────
model Signature {
  id           String   @id @default(cuid())
  signerName   String
  signerDoc    String?
  imagePath    String
  signedAt     DateTime @default(now())
  evidenceData Json?

  companyId String
  reportId  String @unique
  report    Report @relation(fields: [reportId], references: [id])
}

// ─── PDF GERADO ───────────────────────────────────────────────────────────────
model ReportPdf {
  id        String   @id @default(cuid())
  pdfPath   String
  createdAt DateTime @default(now())

  companyId String
  reportId  String @unique
  report    Report @relation(fields: [reportId], references: [id])
}

// ─── HISTÓRICO DE STATUS DA VISITA ───────────────────────────────────────────
model VisitStatusHistory {
  id        String      @id @default(cuid())
  visitId   String
  status    VisitStatus
  changedBy String
  note      String?
  createdAt DateTime    @default(now())

  visit Visit @relation(fields: [visitId], references: [id])
  user  User  @relation(fields: [changedBy], references: [id])

  @@map("visit_status_history")
}

// ─── ORÇAMENTOS ───────────────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

model Quotation {
  id          String          @id @default(cuid())
  title       String
  description String?
  notes       String?
  validUntil  DateTime?
  discount    Decimal         @default(0) @db.Decimal(10, 2)
  subtotal    Decimal         @default(0) @db.Decimal(10, 2)
  total       Decimal         @default(0) @db.Decimal(10, 2)
  status      QuotationStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId   String
  clientId    String
  visitId     String?
  createdById String

  company   Company         @relation(fields: [companyId], references: [id])
  client    Client          @relation(fields: [clientId], references: [id])
  visit     Visit?          @relation(fields: [visitId], references: [id])
  createdBy User            @relation("QuotationsCreated", fields: [createdById], references: [id])
  items     QuotationItem[]
  pdf       QuotationPdf?

  @@index([companyId])
  @@index([clientId])
  @@index([visitId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  order       Int     @default(0)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model QuotationPdf {
  id        String   @id @default(cuid())
  pdfPath   String
  createdAt DateTime @default(now())

  quotationId String @unique
  companyId   String

  quotation Quotation @relation(fields: [quotationId], references: [id])
}
